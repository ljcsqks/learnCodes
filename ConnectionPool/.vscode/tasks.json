{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++.exe 自定义生成活动文件",
			"command": "C:\\msys64\\mingw64\\bin\\g++.exe",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${file}",
				"MysqlConn.cpp",
				"ConnectionPool.cpp",
				"-o",
				"${fileDirname}\\${fileBasenameNoExtension}.exe",
				 // 新增MySQL相关参数
				"-I\"C:/Program Files/MySQL/MySQL Server 8.0/include\"",
				"-L\"C:/Program Files/MySQL/MySQL Server 8.0/lib\"",
				"-lmysql",
				"-fexec-charset=GBK",
				"-finput-charset=UTF-8",
				"-ljsoncpp"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "编译器: C:\\msys64\\mingw64\\bin\\g++.exe"
		}
	]
}